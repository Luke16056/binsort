# Copy this file to .env and fill it in. .env is in .gitignore so the key never goes on GitHub.
# fake = built-in fake AI (default), gemini = real Gemini, down = fake AI that always fails (demo)
BINSORT_AI=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 1 = Flask debug mode (auto-reload and in-browser debugger). Leave at 0 unless you are changing the code.
BINSORT_DEBUG=0
